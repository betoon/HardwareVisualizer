<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <AssemblyName>HardwareVisualizer</AssemblyName>
    <Product>HardwareVisualizer</Product>
    <Authors>Brian E. Toon</Authors>
    <Company>Brian E. Toon</Company>
    <Copyright>Copyright (c) Brian E. Toon 2026</Copyright>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <!--
    LibreHardwareMonitor-master now lives inside this project folder.
    Without this exclusion, the SDK's default recursive glob would pull
    its .cs files (including its WinForms UI code) directly into this
    WPF project's own compilation, causing missing-type errors and
    duplicate-type warnings. It should only be consumed via the
    ProjectReference below.
  -->
  <ItemGroup>
    <Compile Remove="LibreHardwareMonitor-master\**" />
    <EmbeddedResource Remove="LibreHardwareMonitor-master\**" />
    <None Remove="LibreHardwareMonitor-master\**" />
    <Page Remove="LibreHardwareMonitor-master\**" />
    <ApplicationDefinition Remove="LibreHardwareMonitor-master\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PacketDotNet" Version="1.4.8" />
    <PackageReference Include="SharpPcap" Version="6.3.1" />
    <ProjectReference Include="LibreHardwareMonitor-master\LibreHardwareMonitorLib\LibreHardwareMonitorLib.csproj"
                      SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>

</Project>
